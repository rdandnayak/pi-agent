{
  // Global permission policy for pi-permission-system.
  // Smart mode: safe commands run silently, sensitive ones prompt (ask),
  // and dangerous ones are hard-blocked (deny). Last matching rule wins.
  "defaultPolicy": {
    "tools": "allow",
    "bash": "allow",
    "mcp": "ask",
    "skills": "ask",
    "special": "ask"
  },
  "tools": {
    // Reads/searches are safe - allow silently (this is also the default now).
    "read": "allow",
    "grep": "allow",
    "find": "allow",
    "ls": "allow",
    // Writes/edits prompt for confirmation.
    "write": "ask",
    "edit": "ask",

    // SECRETS: .env files are never read/written/edited by the agent.
    // `*` matches across path separators, so these cover any .env anywhere.
    "read:*.env": "deny",
    "read:*.env.*": "deny",
    "grep:*.env": "deny",
    "grep:*.env.*": "deny",
    "write:*.env": "deny",
    "write:*.env.*": "deny",
    "edit:*.env": "deny",
    "edit:*.env.*": "deny"
  },
  "bash": {
    // AZURE CLI: reads pass silently, writes require approval.
    // Catch-all: any az invocation asks first. `*az` (not just `az *`) is used
    // so compound chains like `cd x && az ...` / `VAR=x; az ...` are also
    // caught, which the command-anchored "az *" rule missed. Rule order is
    // last-match-wins, so the read-only ALLOW rules below must come AFTER this
    // broad ASK catch-all.
    "*az *": "ask",
    "*az": "ask",

    // Read-only az commands run silently (these override the catch-all above).
    "*az account list*": "allow",
    "*az account show*": "allow",
    "*az account get-access-token*": "allow",
    "*az group list*": "allow",
    "*az group show*": "allow",
    "*az group exists*": "allow",
    "*az resource list*": "allow",
    "*az resource show*": "allow",
    "*az resource link list*": "allow",
    "*az storage * list*": "allow",
    "*az storage * show*": "allow",
    "*az vm list*": "allow",
    "*az vm show*": "allow",
    "*az vm image list*": "allow",
    "*az webapp list*": "allow",
    "*az webapp show*": "allow",
    "*az functionapp list*": "allow",
    "*az functionapp show*": "allow",
    "*az role assignment list*": "allow",
    "*az role assignment show*": "allow",
    "*az role definition list*": "allow",
    "*az role definition show*": "allow",
    "*az keyvault list*": "allow",
    "*az keyvault show*": "allow",
    "*az keyvault secret list*": "allow",
    "*az keyvault secret show*": "allow",
    "*az network * list*": "allow",
    "*az network * show*": "allow",
    // az rest is method-dependent: GET is read-only, other methods (POST,
    // PUT, DELETE, PATCH...) are mutations and stay on the ask catch-all.
    "*az rest *--method get*": "allow",
    "*az rest *--method GET*": "allow",
    // Azure DevOps reads.
    "*az devops * list*": "allow",
    "*az devops * show*": "allow",
    "*az pipelines * list*": "allow",
    "*az pipelines * show*": "allow",
    "*az repos * list*": "allow",
    "*az repos * show*": "allow",
    "*az repos list*": "allow",
    "*az repos show*": "allow",
    "*az boards * list*": "allow",
    "*az boards * show*": "allow",
    "*az boards list*": "allow",
    "*az boards show*": "allow",
    "*az artifact * list*": "allow",
    "*az artifact * show*": "allow",
    "*az extension list*": "allow",
    "*az extension show*": "allow",
    "*az config list*": "allow",
    "*az config show*": "allow",
    "*az version*": "allow",

    // Safe, read-only / non-destructive commands run silently.
    "git status": "allow",
    "git log *": "allow",
    "git diff *": "allow",
    "git branch": "allow",
    "ls *": "allow",
    "cat *": "allow",
    "head *": "allow",
    "tail *": "allow",
    "wc *": "allow",
    "pwd": "allow",
    "whoami": "allow",
    "date": "allow",
    "npm run *": "allow",
    "npm test": "allow",

    // Git mutations prompt.
    "git add *": "ask",
    "git commit *": "ask",
    "git push *": "ask",
    "git pull *": "ask",
    "git checkout *": "ask",
    "git merge *": "ask",
    "git reset *": "ask",

    // SECRETS: reading .env through common shell tools is blocked.
    // Covers cwd-relative (.env), nested (dir/.env), and flag-prefixed
    // (tail -n 5 .env) invocations.
    "cat .env*": "deny",
    "cat */.env*": "deny",
    "cat * .env*": "deny",
    "less .env*": "deny",
    "less */.env*": "deny",
    "less * .env*": "deny",
    "tail .env*": "deny",
    "tail */.env*": "deny",
    "tail * .env*": "deny",
    "head .env*": "deny",
    "head */.env*": "deny",
    "head * .env*": "deny",
    "sed .env*": "deny",
    "sed */.env*": "deny",
    "sed * .env*": "deny",
    "awk .env*": "deny",
    "awk */.env*": "deny",
    "awk * .env*": "deny",
    "grep .env*": "deny",
    "grep */.env*": "deny",
    "grep * .env*": "deny",
    "more .env*": "deny",
    "more */.env*": "deny",
    "more * .env*": "deny",
    "type .env*": "deny",
    "type */.env*": "deny",
    "type * .env*": "deny",

    // EXTERNAL BASH WRITES: deny redirects/writes to absolute system paths that
    // are never inside any project. /tmp is deliberately NOT restricted - it is
    // the standard scratch location. Bash matching is string-only (no cwd/path
    // resolution), so these target clearly-external system locations.
    "* > /etc/*": "deny",
    "* >> /etc/*": "deny",
    "* > /var/*": "deny",
    "* >> /var/*": "deny",
    "* > /usr/*": "deny",
    "* >> /usr/*": "deny",
    "* > /root/*": "deny",
    "* >> /root/*": "deny",
    "* > /opt/*": "deny",
    "* >> /opt/*": "deny",
    "* > /mnt/*": "deny",
    "* >> /mnt/*": "deny",
    "* > /bin/*": "deny",
    "* > /sbin/*": "deny",
    "* > /lib/*": "deny",
    "* > /boot/*": "deny",
    "* > /dev/*": "deny",
    "touch /etc/*": "deny",
    "touch /var/*": "deny",
    "touch /usr/*": "deny",
    "touch /root/*": "deny",
    "touch /opt/*": "deny",
    "tee /etc/*": "deny",
    "tee /var/*": "deny",
    "tee /usr/*": "deny",
    "tee /root/*": "deny",
    "tee /opt/*": "deny",

    // DANGEROUS: hard block (cannot be overridden even by allow).
    "rm -rf *": "deny",
    "sudo *": "deny",
    "curl * | sh": "deny",
    "curl * | bash": "deny",
    "dd if=*": "deny",
    "git push --force*": "deny",
    "git push -f*": "deny",

    // Additional dangerous commands from best-practice references.
    "wget * | sh": "deny",
    "wget * | bash": "deny",
    "find * -delete*": "deny",
    "mkfs.*": "deny",
    "chmod *777*": "deny",
    "chown -R *": "deny",
    "docker system prune*": "deny",
    "docker rm -f *": "deny",
    "shutdown*": "deny",
    "reboot*": "deny",
    "halt*": "deny",
    "poweroff*": "deny",
    "git clean*": "deny",
    "npm unpublish*": "deny",
    "su -*": "deny",
    "DROP TABLE *": "deny",
    "TRUNCATE *": "deny",
    "DELETE FROM *": "deny",
    "psql *DROP TABLE*": "deny",
    "psql *TRUNCATE*": "deny",
    "mysql *DROP TABLE*": "deny",
    "mysql *TRUNCATE*": "deny",
    "git reset --hard*": "deny"
  },
  "skills": {
    "*": "ask"
  },
  "special": {
    "doom_loop": "deny",
    // Allow reads outside the project; writes/edits are still gated by the
    // tools layer (write:ask / edit:ask) which applies after this fall-through.
    "external_directory": "allow"
  }
}

{
  // Global permission policy for pi-permission-system.
  // Smart mode: safe commands run silently, sensitive ones prompt (ask),
  // and dangerous ones are hard-blocked (deny). Last matching rule wins.
  "defaultPolicy": {
    "tools": "allow",
    "bash": "allow",
    "mcp": "ask",
    "skills": "ask",
    "special": "ask"
  },
  "tools": {
    // Reads/searches are safe - allow silently (this is also the default now).
    "read": "allow",
    "grep": "allow",
    "find": "allow",
    "ls": "allow",
    // Writes/edits prompt for confirmation.
    "write": "ask",
    "edit": "ask",

    // SECRETS: .env files are never read/written/edited by the agent.
    // `*` matches across path separators, so these cover any .env anywhere.
    "read:*.env": "deny",
    "read:*.env.*": "deny",
    "grep:*.env": "deny",
    "grep:*.env.*": "deny",
    "write:*.env": "deny",
    "write:*.env.*": "deny",
    "edit:*.env": "deny",
    "edit:*.env.*": "deny"
  },
  "bash": {
    // AZURE CLI: always require approval.
    "az *": "ask",
    "az": "ask",

    // Safe, read-only / non-destructive commands run silently.
    "git status": "allow",
    "git log *": "allow",
    "git diff *": "allow",
    "git branch": "allow",
    "ls *": "allow",
    "cat *": "allow",
    "head *": "allow",
    "tail *": "allow",
    "wc *": "allow",
    "pwd": "allow",
    "whoami": "allow",
    "date": "allow",
    "npm run *": "allow",
    "npm test": "allow",

    // Git mutations prompt.
    "git add *": "ask",
    "git commit *": "ask",
    "git push *": "ask",
    "git pull *": "ask",
    "git checkout *": "ask",
    "git merge *": "ask",
    "git reset *": "ask",

    // SECRETS: reading .env through common shell tools is blocked.
    // Covers cwd-relative (.env), nested (dir/.env), and flag-prefixed
    // (tail -n 5 .env) invocations.
    "cat .env*": "deny",
    "cat */.env*": "deny",
    "cat * .env*": "deny",
    "less .env*": "deny",
    "less */.env*": "deny",
    "less * .env*": "deny",
    "tail .env*": "deny",
    "tail */.env*": "deny",
    "tail * .env*": "deny",
    "head .env*": "deny",
    "head */.env*": "deny",
    "head * .env*": "deny",
    "sed .env*": "deny",
    "sed */.env*": "deny",
    "sed * .env*": "deny",
    "awk .env*": "deny",
    "awk */.env*": "deny",
    "awk * .env*": "deny",
    "grep .env*": "deny",
    "grep */.env*": "deny",
    "grep * .env*": "deny",
    "more .env*": "deny",
    "more */.env*": "deny",
    "more * .env*": "deny",
    "type .env*": "deny",
    "type */.env*": "deny",
    "type * .env*": "deny",

    // DANGEROUS: hard block (cannot be overridden even by allow).
    "rm -rf *": "deny",
    "sudo *": "deny",
    "curl * | sh": "deny",
    "curl * | bash": "deny",
    "dd if=*": "deny",
    "git push --force*": "deny",
    "git push -f*": "deny"
  },
  "skills": {
    "*": "ask"
  },
  "special": {
    "doom_loop": "deny",
    "external_directory": "ask"
  }
}
